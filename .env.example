# Copy to .env and fill in real values before running docker compose.
# Variables marked (required) have no default; the app refuses to start
# without them.

# --- Django ---
# e.g. config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=
# (required) long random string
DJANGO_SECRET_KEY=
# boolean (True/False)
DJANGO_DEBUG=
# comma-separated host names
DJANGO_ALLOWED_HOSTS=

# --- Database (Postgres) ---
# (required unless USE_SQLITE=True)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands against local
# SQLite with no Postgres/Docker available (e.g. `manage.py check`,
# `makemigrations`, `test`). Never set this in docker-compose/production.
USE_SQLITE=

# --- JWT (SimpleJWT) ---
# (required) long random string used to sign tokens
JWT_SIGNING_KEY=
# access token lifetime in minutes (integer)
ACCESS_TOKEN_LIFETIME=
# refresh token lifetime in days (integer)
REFRESH_TOKEN_LIFETIME=

# --- Security (prod settings) ---
# boolean (True/False)
SECURE_SSL_REDIRECT=
# HSTS max-age in seconds (integer)
SECURE_HSTS_SECONDS=

# --- CORS ---
# comma-separated origins
CORS_ALLOWED_ORIGINS=

# --- Frontend ---
VITE_API_BASE_URL=
